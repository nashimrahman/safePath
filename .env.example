# =============================================
# SafePath – Environment Variables
# =============================================
# Copy this file to .env and fill in real values

# --- Mapping ---
# Leave empty to use OpenStreetMap (free, no key required)
VITE_MAP_PROVIDER_KEY=

# --- Places API (for real open-business data) ---
# Supported: Google Places API
VITE_PLACES_PROVIDER_KEY=

# --- Routing API ---
VITE_ROUTING_PROVIDER_KEY=

# --- AWS Backend ---
AWS_REGION=eu-west-1
AWS_API_URL=
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# --- Demo Mode ---
# Set to true to use demo/seed data (default)
VITE_DEMO_MODE=true
